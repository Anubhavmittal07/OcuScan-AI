# ==============================================================================
# OcuScan AI — Environment Configuration Example (.env.example)
# Rename to .env for local overrides. DO NOT commit production secrets.
# ==============================================================================

# Runtime environment (development / production)
ENV=development
DEBUG=false

# Server network binding
HOST=127.0.0.1
PORT=8000

# Database Persistence
# Local Development: SQLite (default)
DATABASE_URL=sqlite:///./data/eyehealthai.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/eyehealthai

# CORS Allowed Origins (comma-separated list)
# In production, restrict to your dashboard domain (e.g. https://ocuscan.hospital.org)
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# File upload constraints (in Megabytes)
MAX_UPLOAD_SIZE_MB=10

# Hardware compute device ('cpu' or 'cuda')
DEVICE=cpu

# ==============================================================================
# SMTP & AUTOMATED EMAIL DELIVERY SERVICE
# ==============================================================================
# When configured, completed screening reports (PDF) are automatically dispatched
# to the participant's registered email (provided consent was granted).
# If unconfigured, the system truthfully logs "unconfigured" and preserves the PDF
# for direct local download/print without failing the screening session.

# Enable or disable automated dispatch upon screening completion (true / false)
AUTOMATIC_EMAIL_DISPATCH=true

# Outbound SMTP Server Hostname
# Examples:
#   Gmail:           smtp.gmail.com
#   SendGrid:        smtp.sendgrid.net
#   Amazon SES:      email-smtp.us-east-1.amazonaws.com
#   Office 365:      smtp.office365.com
#   Local Relay:     127.0.0.1
SMTP_HOST=

# Outbound SMTP Server Port (587 for STARTTLS, 465 for SSL/TLS, 25 for local relay)
SMTP_PORT=587

# Outbound SMTP Username / Identity
#   Gmail:           your_full_email@gmail.com
#   SendGrid:        apikey
#   Amazon SES:      Your-SES-SMTP-Username
#   Office 365:      your_email@organization.com
SMTP_USER=

# Outbound SMTP Password / API Key
#   Gmail:           Use a 16-character App Password (from myaccount.google.com -> Security -> 2-Step Verification -> App Passwords)
#   SendGrid:        Your SendGrid API Key (starts with SG...)
#   Amazon SES:      Your SES SMTP Password
#   Office 365:      Your Office 365 Password or App Password
SMTP_PASSWORD=

# Sender Display Name and From Address
# Must match verified domain in SendGrid / SES or account identity in Gmail/Outlook
SMTP_FROM=OcuScan AI Health Screening <noreply@eyehealthai.local>

# TLS / SSL Security Protocol
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Socket connection and transmission timeout (in seconds)
SMTP_TIMEOUT_SECONDS=15

# ==============================================================================
# AI COPILOT & LLM ASSISTANTS (OPTIONAL)
# ==============================================================================

# Optional OpenAI Integration (Official SDK for Dr. Astra & Secondary Vision)
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional Gemini Research Copilot Integration
# Obtain from https://aistudio.google.com/
# Leave empty to operate in offline fallback mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Custom Model Checkpoint Locations (defaults to workspace saved_models/)
# ANEMIA_CHECKPOINT_PATH=saved_models/anemia/best_model.pth
# SLID_CHECKPOINT_PATH=saved_models/slid/best_model.pth
# JAUNDICE_CHECKPOINT_PATH=saved_models/jaundice/best_model.pth
# CATARACT_CHECKPOINT_PATH=saved_models/cataract/best_model.pth
# STYE_CHECKPOINT_PATH=saved_models/stye/best_model.pth
